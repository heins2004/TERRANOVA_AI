# Application runtime environment: "development" or "production"
APP_ENV=production

# Explicit deployment flag: "1" for deployed environments, empty or "0" for local
DEPLOYED=1

# PostgreSQL connection string with credentials, host, port, and database name
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>

# Comma-separated list of allowed frontend origins for CORS headers
FRONTEND_ORIGINS=https://<frontend_domain>

# Name of the HTTP session cookie
SESSION_COOKIE_NAME=terranova_session

# Session expiration time in seconds (e.g. 604800 for 7 days)
SESSION_MAX_AGE_SECONDS=604800

# Require HTTPS for session cookies (forced True in production/deployed mode)
SESSION_COOKIE_SECURE=true

# SameSite policy for session cookies: "lax", "strict", or "none"
SESSION_COOKIE_SAMESITE=lax

# Maximum public API requests allowed per client IP within the rate-limit window
RATE_LIMIT_PUBLIC_MAX_REQUESTS=120

# Time window in seconds for public API rate limiting
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=60

# Maximum consecutive failed login attempts allowed before IP/email lockout
RATE_LIMIT_LOGIN_MAX_FAILURES=10

# Lockout and window duration in seconds for failed login attempts (e.g. 900 for 15 mins)
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900

# Trusted reverse-proxy header for client IP extraction (e.g. "X-Forwarded-For" or "CF-Connecting-IP")
RATE_LIMIT_REAL_IP_HEADER=<trusted_header_name>

# Optional database URL override used exclusively by database migration commands
MIGRATION_DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>

# Optional target database name override used by database migration commands
MIGRATION_DB_NAME=<migration_target_db>

# Flag to seed synthetic demo projects and comments (set to "1" to enable, omitted or "0" in production)
SEED_DEMO=0

# Secret password for the initial administrator creation CLI (min 12 characters, never logged)
TERRANOVA_ADMIN_PASSWORD=<admin_bootstrap_password_min_12_chars>
