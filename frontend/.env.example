# Public base URL of the backend REST API accessed by the browser and client code.
# READ AT BUILD TIME: this variable is inlined into the JavaScript bundle by Next.js.
# It MUST be set before running `next build` in production; the build will fail loudly
# if it is missing. In local development it falls back to http://localhost:8000.
NEXT_PUBLIC_API_BASE_URL=https://<api_backend_domain>
